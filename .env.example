# Physical device: use your computer's LAN IP, e.g. http://192.168.1.10:8000
# Android emulator: http://10.0.2.2:8000; iOS simulator/web: http://localhost:8000
EXPO_PUBLIC_API_URL=http://localhost:8000
# Firebase is used only for chat. No email/password Firebase provider is needed.
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
